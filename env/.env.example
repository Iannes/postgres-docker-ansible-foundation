# =============================================================================
# Smart Market — Environment Configuration Template
# =============================================================================
# Copy this file to .env at the project root before running anything:
#
#   cp env/.env.example .env
#
# Then replace every CHANGEME_ placeholder with a real value.
# NEVER commit .env to version control.
#
# GENERATING PASSWORDS
#   openssl rand -base64 32
#
# SECRETS NOTE
#   This file and .env are deployment plumbing, not a secure vault.
#   Environment variables passed to containers are visible via 'docker inspect'
#   and /proc on the host. They are NOT equivalent to a secrets manager.
#   In production, Ansible Vault holds the real values and writes .env to the
#   server at deploy time with mode 600. Treat this file accordingly.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL image
# -----------------------------------------------------------------------------
# Pin to a specific minor version. Never use 'latest'.
# To upgrade: test locally with the new tag first, then update here.
# See docs/upgrade-postgres.md (Phase 4).

POSTGRES_IMAGE_TAG=16.3


# -----------------------------------------------------------------------------
# PostgreSQL superuser
# -----------------------------------------------------------------------------
# Used for bootstrap, operator access, and running migrations.
# The pipeline runtime (smartmarket_pipeline) must NOT use these credentials.

POSTGRES_DB=smartmarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_openssl_rand_base64_32

# Authentication method for TCP (host) connections in pg_hba.conf.
# scram-sha-256 is required. Do not change to md5 or trust.
POSTGRES_HOST_AUTH_METHOD=scram-sha-256


# -----------------------------------------------------------------------------
# Application roles
# -----------------------------------------------------------------------------
# These are created by docker/postgres/initdb/01-roles.sh on first volume
# initialisation. They are not used to start the container.

# smartmarket_migrations: run by the pipeline migration runner (DDL rights).
# Used with a migration tool (e.g. golang-migrate, Flyway) to apply schema
# changes. Never used for application runtime queries.
SMARTMARKET_MIGRATIONS_PASSWORD=CHANGEME_openssl_rand_base64_32

# smartmarket_pipeline: run by the pipeline at runtime (DML rights only).
# SELECT, INSERT, UPDATE, DELETE on tables in the smartmarket schema.
# No CREATE, ALTER, or DROP access.
SMARTMARKET_PIPELINE_PASSWORD=CHANGEME_openssl_rand_base64_32


# -----------------------------------------------------------------------------
# Local development — port binding
# -----------------------------------------------------------------------------
# Used by docker-compose.override.yml only. Not present in production Compose.
# Always binds to 127.0.0.1. Do not change the bind address.
# Change this port if 5432 is already in use on your machine.

POSTGRES_LOCAL_PORT=5432


# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
# BACKUP_DIR: where pg_dump files are written on this host.
#   - Relative paths are resolved from the project root.
#   - This directory is git-ignored. Do not store backups inside the repo.
#   - In production, point this at a dedicated volume or mount.

BACKUP_DIR=./backups

# BACKUP_RETENTION_COUNT: number of most-recent backups to keep locally.
#   Older backups beyond this count are removed by scripts/backup.sh.
#   Set higher if you have disk headroom; a pipeline DB can generate large dumps.

BACKUP_RETENTION_COUNT=7


# -----------------------------------------------------------------------------
# Operational reference (not consumed by scripts — documentation only)
# -----------------------------------------------------------------------------
#
# DISK
#   The postgres_data Docker volume grows with your data.
#   Check usage:    docker system df -v
#   Volume path:    docker volume inspect smartmarket_postgres_data
#   Dumps grow proportionally to data volume. Monitor BACKUP_DIR size.
#
# LOGS
#   Container log rotation: 10 MB / 3 files (set in docker-compose.yml).
#   If you enable verbose query logging (log_min_duration_statement),
#   expect significantly higher log volume. Tune max-size/max-file accordingly.
#
# MEMORY
#   PostgreSQL uses default memory settings (shared_buffers ~128MB).
#   If you observe OOM events or query performance issues, add a custom
#   postgresql.conf via a volume mount (Phase 2+).
#   Minimum recommended host RAM for this stack: 1 GB.
#
# CONNECTIONS
#   Default max_connections = 100. A pipeline with controlled connection
#   patterns is unlikely to need pgBouncer initially. Add it if you observe
#   connection exhaustion.
