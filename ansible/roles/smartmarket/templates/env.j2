# =============================================================================
# Smart Market — Production Environment Configuration
# /opt/smartmarket/.env
# =============================================================================
# Managed by Ansible (role: smartmarket). Do not edit manually.
# Changes will be overwritten on the next Ansible run.
#
# This file is mode 600 and owned by {{ deploy_user }}. It is read by Docker
# Compose at startup via --env-file. It is deployment plumbing, not a vault.
# Credentials are visible via 'docker inspect' and /proc/<pid>/environ to any
# process running as root or {{ deploy_user }} on this host.
#
# Source of truth: ansible/group_vars/all/vault.yml (Ansible Vault, encrypted)
# Template:        ansible/roles/smartmarket/templates/env.j2
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL image
# ---------------------------------------------------------------------------
# Pinned to a specific minor version. Never use 'latest'.
# To upgrade: update postgres_image_tag in vars.yml, test locally, then deploy.
# See docs/ for the upgrade procedure (Phase 4).
POSTGRES_IMAGE_TAG={{ postgres_image_tag }}

# ---------------------------------------------------------------------------
# PostgreSQL superuser
# ---------------------------------------------------------------------------
# Used for operator access and bootstrap only.
# Application processes must never connect as this user.
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

# Authentication method for TCP (host) connections.
# scram-sha-256 is required. Do not change.
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ---------------------------------------------------------------------------
# Application roles
# ---------------------------------------------------------------------------
# These are consumed by docker/postgres/initdb/01-roles.sh on first volume
# initialisation only. Not used at container runtime after that.
SMARTMARKET_MIGRATIONS_PASSWORD={{ vault_migrations_password }}
SMARTMARKET_PIPELINE_PASSWORD={{ vault_pipeline_password }}

# ---------------------------------------------------------------------------
# Backup configuration
# ---------------------------------------------------------------------------
BACKUP_DIR={{ smartmarket_app_dir }}/backups
BACKUP_RETENTION_COUNT={{ backup_retention_count }}

# ---------------------------------------------------------------------------
# Note: POSTGRES_LOCAL_PORT is intentionally absent.
# ---------------------------------------------------------------------------
# Production does not publish port 5432 to the host. There is no local port
# binding in production. Admin access is via SSH tunnel only.
# See docs/operations.md for the SSH tunnel access procedure.
